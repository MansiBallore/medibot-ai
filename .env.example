# ════════════════════════════════════════════════════════════
# MediBot AI — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=MediBot AI
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-64-chars

# ── AI Provider ───────────────────────────────────────────────
# Choose one: "gemini" | "openai" | "groq" | "fallback"
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# ── AI API Keys (add the one you're using) ───────────────────
# Get Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get Groq key (free): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Database ─────────────────────────────────────────────────
# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=medibot

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-jwt-secret-also-random-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── OCR ──────────────────────────────────────────────────────
# Linux: /usr/bin/tesseract
# Mac:   /usr/local/bin/tesseract  (brew install tesseract)
# Win:   C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract

# ── RAG ──────────────────────────────────────────────────────
VECTOR_DB_PATH=./data/vectorstore
MEDICAL_DOCS_PATH=./data/medical_docs
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
